<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 获取读取应用列表权限 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 后台下载要在通知栏显示进度，Android 13+ 需要运行时授权 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 下载目录固定为 /storage/emulated/0/Download/VioletBox，Android 10+ 分区存储下
         需要 MediaStore 写入公共下载目录；Android 11+ 的 Download 目录本身可直接写 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 11+ 分区存储：要直接写 /storage/emulated/0/Download/VioletBox，
         需要「所有文件访问权限」；未授权时会用 root 兜底，不影响使用。 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name="com.violet.box.VioletApplication"
        android:allowBackup="true"        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.紫罗兰盒子">
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.selinux.SelinuxManagerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.partition.PartitionManagerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.font.FontLibraryBackupActivity"
            android:exported="false" />
        <activity
            android:name=".ui.module.ModuleManagerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.module.ModuleBackupActivity"
            android:exported="false" />
        <activity
            android:name=".ui.appmanager.AppManagerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.payload.PayloadActivity"
            android:exported="false" />
        <activity
            android:name=".ui.rom.RomZoneActivity"
            android:exported="false"
            android:label="ROM 专区" />
        <activity
            android:name=".ui.rom.RomDownloadsActivity"
            android:exported="false"
            android:label="下载管理" />
        <activity
            android:name=".ui.plugin.VioletPluginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.plugin.TrickyStoreConfigActivity"
            android:exported="false" />
        <activity
            android:name=".ui.plugin.TrickyStoreAppListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.plugin.TrickyStoreSecurityPatchActivity"
            android:exported="false" />
        <activity
            android:name=".ui.plugin.TrickyStoreHashActivity"
            android:exported="false" />
        <activity
            android:name=".ui.plugin.HiddenAppListConfigActivity"
            android:exported="false" />
        <activity
            android:name=".ui.plugin.SusfsConfigActivity"
            android:exported="false" />
        <activity
            android:name=".ui.plugin.KernelDisguiseActivity"
            android:exported="false" />
        <activity
            android:name=".ui.plugin.GlobalDeviceSpoofActivity"
            android:exported="false" />
        <activity
            android:name=".ui.plugin.DeviceIdModifyActivity"
            android:exported="false" />
        <activity
            android:name=".ui.about.AboutActivity"
            android:exported="false" />
        <activity
            android:name=".ui.repo.ModuleRepoActivity"
            android:exported="false" />


        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <receiver
            android:name=".receiver.BootCompletedReceiver"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
