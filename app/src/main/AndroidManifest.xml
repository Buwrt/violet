<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 获取读取应用列表权限 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 后台下载要在通知栏显示进度，Android 13+ 需要运行时授权 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 下载目录固定为 /storage/emulated/0/Download/VioletBox，Android 10+ 分区存储下
         需要 MediaStore 写入公共下载目录；Android 11+ 的 Download 目录本身可直接写 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 11+ 分区存储：要直接写 /storage/emulated/0/Download/VioletBox，
         需要「所有文件访问权限」；未授权时会用 root 兜底，不影响使用。 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- ===== 云析 YunX 所需权限 ===== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name="com.violet.box.VioletApplication"
        android:allowBackup="true"        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.紫罗兰盒子">
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.selinux.SelinuxManagerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.partition.PartitionManagerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.font.FontLibraryBackupActivity"
            android:exported="false" />
        <activity
            android:name=".ui.module.ModuleManagerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.module.ModuleBackupActivity"
            android:exported="false" />
        <activity
            android:name=".ui.appmanager.AppManagerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.payload.PayloadActivity"
            android:exported="false" />
        <activity
            android:name=".ui.rom.RomZoneActivity"
            android:exported="false"
            android:label="ROM 专区" />
        <activity
            android:name=".ui.rom.RomDownloadsActivity"
            android:exported="false"
            android:label="下载管理" />
        <activity
            android:name=".ui.plugin.VioletPluginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.plugin.TrickyStoreConfigActivity"
            android:exported="false" />
        <activity
            android:name=".ui.plugin.TrickyStoreAppListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.plugin.TrickyStoreSecurityPatchActivity"
            android:exported="false" />
        <activity
            android:name=".ui.plugin.TrickyStoreHashActivity"
            android:exported="false" />
        <activity
            android:name=".ui.plugin.HiddenAppListConfigActivity"
            android:exported="false" />
        <activity
            android:name=".ui.plugin.SusfsConfigActivity"
            android:exported="false" />
        <activity
            android:name=".ui.plugin.KernelDisguiseActivity"
            android:exported="false" />
        <activity
            android:name=".ui.plugin.GlobalDeviceSpoofActivity"
            android:exported="false" />
        <activity
            android:name=".ui.plugin.DeviceIdModifyActivity"
            android:exported="false" />
        <activity
            android:name=".ui.about.AboutActivity"
            android:exported="false" />
        <activity
            android:name=".ui.repo.ModuleRepoActivity"
            android:exported="false" />


        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <receiver
            android:name=".receiver.BootCompletedReceiver"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- ===== 云析 YunX（AGPL-3.0，来自 github.com/CYQawa/YunX）=====
             网盘 / 视频链接解析与高速下载。入口在「玩机」页的「云析」卡片。
             exported=true 仅供 violet 内部 startActivity，不注册 launcher。 -->
        <activity
            android:name="com.yunx.app.MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:label="@string/yunx_app_name"
            android:theme="@style/Theme.ComposeEmptyActivity" />

        <!-- ============================ 深链接（按平台注册，可在设置里逐个关掉） ============================
             为什么要用 activity-alias 而不是直接写在 MainActivity 上：清单里的 intent-filter 无法在运行时修改，
             要让用户能在设置里改「哪些链接由云析接管」，只能把每种链接挂到独立的 alias 上，
             再用 PackageManager.setComponentEnabledSetting 启停（与桌面动态图标同一套机制，见 ThemeScreen）。
             ★ 这些 alias 的类名必须与 data/prefs/LinkOpenTarget.kt 里的 alias 常量逐字一致。
             ★ 一律不开 autoVerify：pan.quark.cn / pan.baidu.com 这些域名不是我们的，放不了 assetlinks.json，
               校验失败反而会被系统排除掉；不开校验就是普通深链接——首次点链接弹「打开方式」，选云析后可设默认。
             ★ 只注册 ShareLinkParser 真正认得的 URL 形态（路径前缀与解析正则对齐），避免抢走处理不了的链接。 -->

        <!-- 夸克网盘：pan.quark.cn/s/xxx -->
        <activity-alias
            android:name="com.yunx.app.link.QuarkLink"
            android:exported="true"
            android:label="@string/yunx_app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity="com.yunx.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pan.quark.cn" android:pathPrefix="/s/" />
            </intent-filter>
        </activity-alias>

        <!-- UC 网盘：drive.uc.cn/s/xxx -->
        <activity-alias
            android:name="com.yunx.app.link.UcLink"
            android:exported="true"
            android:label="@string/yunx_app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity="com.yunx.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="drive.uc.cn" android:pathPrefix="/s/" />
            </intent-filter>
        </activity-alias>

        <!-- 迅雷网盘：pan.xunlei.com/s/xxx -->
        <activity-alias
            android:name="com.yunx.app.link.XunleiLink"
            android:exported="true"
            android:label="@string/yunx_app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity="com.yunx.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pan.xunlei.com" android:pathPrefix="/s/" />
            </intent-filter>
        </activity-alias>

        <!-- 百度网盘：pan.baidu.com/s/1xxx -->
        <activity-alias
            android:name="com.yunx.app.link.BaiduLink"
            android:exported="true"
            android:label="@string/yunx_app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity="com.yunx.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pan.baidu.com" android:pathPrefix="/s/" />
            </intent-filter>
        </activity-alias>

        <!-- 139（和彩云）：yun.139.com/shareweb/.../w/i/xxx -->
        <activity-alias
            android:name="com.yunx.app.link.C139Link"
            android:exported="true"
            android:label="@string/yunx_app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity="com.yunx.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="yun.139.com" android:pathPrefix="/shareweb/" />
            </intent-filter>
        </activity-alias>

        <!-- 123 云盘：www.123pan.com/s/xxx、www.123865.com/s/xxx、www.123pan.cn/s/xxx、<UID>.share.123pan.cn/123pan/xxx
             四种形态路径规则不同，必须一个 <data> 一条 intent-filter —— 同一 filter 内的多条 <data> 会被
             并成「scheme/host/path 三个集合求交」，路径会串到别的 host 上。 -->
        <activity-alias
            android:name="com.yunx.app.link.Pan123Link"
            android:exported="true"
            android:label="@string/yunx_app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity="com.yunx.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.123pan.com" android:pathPrefix="/s/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.123865.com" android:pathPrefix="/s/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.123pan.cn" android:pathPrefix="/s/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="share.123pan.cn" android:pathPrefix="/123pan/" />
                <data android:scheme="https" android:host="*.share.123pan.cn" android:pathPrefix="/123pan/" />
            </intent-filter>
        </activity-alias>

        <!-- 115 网盘：115.com/s/<code>、以及口令形态 115.com/<code>-<提取码>/（code 以 sw 开头） -->
        <activity-alias
            android:name="com.yunx.app.link.Pan115Link"
            android:exported="true"
            android:label="@string/yunx_app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity="com.yunx.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="115.com" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="115cdn.com" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="115rc.com" android:pathPrefix="/s/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- 口令形态：路径以 /sw 开头（分隔符用 pathPrefix 而不是 pathPattern：
                     pathPattern 是 SIMPLE_GLOB，`*` 表示「重复前一个字符」而不是任意串，/sw* 匹配不到 /sws8xxx） -->
                <data android:scheme="https" android:host="115.com" android:pathPrefix="/sw" />
                <data android:scheme="https" android:host="115cdn.com" android:pathPrefix="/sw" />
                <data android:scheme="https" android:host="115rc.com" android:pathPrefix="/sw" />
            </intent-filter>
        </activity-alias>

        <!-- 光鸭云盘：www.guangyapan.com/s/xxx -->
        <activity-alias
            android:name="com.yunx.app.link.GuangyaLink"
            android:exported="true"
            android:label="@string/yunx_app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity="com.yunx.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.guangyapan.com" android:pathPrefix="/s/" />
            </intent-filter>
        </activity-alias>

        <!-- 蓝奏云：域名族 lanzou* 的 a-z 轮换域名（bare 与 *. 两种写法都要列，清单通配符只能匹配最左一级）
             蓝奏云优享版：ilanzou.com/net/org/cn/s/xxx -->
        <activity-alias
            android:name="com.yunx.app.link.LanzouLink"
            android:exported="true"
            android:label="@string/yunx_app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity="com.yunx.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="lanzou.com" />
                <data android:scheme="https" android:host="*.lanzou.com" />
                <data android:scheme="https" android:host="lanzoua.com" />
                <data android:scheme="https" android:host="*.lanzoua.com" />
                <data android:scheme="https" android:host="lanzoub.com" />
                <data android:scheme="https" android:host="*.lanzoub.com" />
                <data android:scheme="https" android:host="lanzouc.com" />
                <data android:scheme="https" android:host="*.lanzouc.com" />
                <data android:scheme="https" android:host="lanzoud.com" />
                <data android:scheme="https" android:host="*.lanzoud.com" />
                <data android:scheme="https" android:host="lanzoue.com" />
                <data android:scheme="https" android:host="*.lanzoue.com" />
                <data android:scheme="https" android:host="lanzouf.com" />
                <data android:scheme="https" android:host="*.lanzouf.com" />
                <data android:scheme="https" android:host="lanzoug.com" />
                <data android:scheme="https" android:host="*.lanzoug.com" />
                <data android:scheme="https" android:host="lanzouh.com" />
                <data android:scheme="https" android:host="*.lanzouh.com" />
                <data android:scheme="https" android:host="lanzoui.com" />
                <data android:scheme="https" android:host="*.lanzoui.com" />
                <data android:scheme="https" android:host="lanzouj.com" />
                <data android:scheme="https" android:host="*.lanzouj.com" />
                <data android:scheme="https" android:host="lanzouk.com" />
                <data android:scheme="https" android:host="*.lanzouk.com" />
                <data android:scheme="https" android:host="lanzoul.com" />
                <data android:scheme="https" android:host="*.lanzoul.com" />
                <data android:scheme="https" android:host="lanzoum.com" />
                <data android:scheme="https" android:host="*.lanzoum.com" />
                <data android:scheme="https" android:host="lanzoun.com" />
                <data android:scheme="https" android:host="*.lanzoun.com" />
                <data android:scheme="https" android:host="lanzouo.com" />
                <data android:scheme="https" android:host="*.lanzouo.com" />
                <data android:scheme="https" android:host="lanzoup.com" />
                <data android:scheme="https" android:host="*.lanzoup.com" />
                <data android:scheme="https" android:host="lanzouq.com" />
                <data android:scheme="https" android:host="*.lanzouq.com" />
                <data android:scheme="https" android:host="lanzour.com" />
                <data android:scheme="https" android:host="*.lanzour.com" />
                <data android:scheme="https" android:host="lanzous.com" />
                <data android:scheme="https" android:host="*.lanzous.com" />
                <data android:scheme="https" android:host="lanzout.com" />
                <data android:scheme="https" android:host="*.lanzout.com" />
                <data android:scheme="https" android:host="lanzouu.com" />
                <data android:scheme="https" android:host="*.lanzouu.com" />
                <data android:scheme="https" android:host="lanzouv.com" />
                <data android:scheme="https" android:host="*.lanzouv.com" />
                <data android:scheme="https" android:host="lanzouw.com" />
                <data android:scheme="https" android:host="*.lanzouw.com" />
                <data android:scheme="https" android:host="lanzoux.com" />
                <data android:scheme="https" android:host="*.lanzoux.com" />
                <data android:scheme="https" android:host="lanzouy.com" />
                <data android:scheme="https" android:host="*.lanzouy.com" />
                <data android:scheme="https" android:host="lanzouz.com" />
                <data android:scheme="https" android:host="*.lanzouz.com" />
                <data android:scheme="https" android:host="ilanzou.com" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="ilanzou.net" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="ilanzou.org" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="ilanzou.cn" android:pathPrefix="/s/" />
            </intent-filter>
        </activity-alias>

        <!-- 磁力链接：magnet:?xt=urn:btih:...（只有 Gopeed 引擎能下，进下载页的「添加下载任务」弹窗预填） -->
        <activity-alias
            android:name="com.yunx.app.link.MagnetLink"
            android:exported="true"
            android:label="@string/yunx_app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity="com.yunx.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magnet" />
            </intent-filter>
        </activity-alias>

        <!-- 自有协议：yunx://resolve?url=<encode 后的分享链接>&pwd=xxxx
             用于其它 App/网页/二维码精确拉起（不受上面域名白名单限制，也是蓝奏云那些列不全的域名的兜底） -->
        <activity-alias
            android:name="com.yunx.app.link.YunxLink"
            android:exported="true"
            android:label="@string/yunx_app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity="com.yunx.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="yunx" />
            </intent-filter>
        </activity-alias>

        <!-- 分享到云析：在别的 App 里「分享 → 云析」（文本 / 口令 / 分享链接都收） -->
        <activity-alias
            android:name="com.yunx.app.link.ShareLink"
            android:exported="true"
            android:label="@string/yunx_app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity="com.yunx.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- 选中文本解析：长按选中一段文字后，系统文本选择菜单（三点 → 更多）里出现「用云析解析」。
             这是安卓官方的「把选中文本交给第三方 App 处理」入口（PROCESS_TEXT），不需要 ROM 白名单，
             也是系统侧那些「复制口令后推荐打开某 App」能力在标准安卓上唯一可由第三方占据的位置。
             label 单独用一个字符串：菜单里显示成「用云析解析」比光秃秃一个「云析」清楚。 -->
        <activity-alias
            android:name="com.yunx.app.link.ProcessTextLink"
            android:exported="true"
            android:label="@string/process_text_action"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity="com.yunx.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- 桌面图标动态切换（新图标）：默认禁用，主题与外观页切换后经 setComponentEnabledSetting 启用。
             图标走 @drawable/ic_launcher_new：API 26+ 为自适应图标（drawable-v26），API 24-25 为位图回退。
             roundIcon 必须一并声明：部分启动器优先取 roundIcon，缺省会回落到 application 的经典图标。 -->
        <activity-alias
            android:name=".MainActivityIcon2"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_new"
            android:roundIcon="@drawable/ic_launcher_new"
            android:label="@string/yunx_app_name"
            android:targetActivity="com.yunx.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 崩溃界面：独立进程运行，避免主线程崩溃后无法展示 UI -->
        <activity
            android:name="com.yunx.app.crash.CrashActivity"
            android:exported="false"
            android:process=":crash"
            android:theme="@style/Theme.ComposeEmptyActivity" />

        <!-- 下载前台服务：下载中保持前台，避免后台限速/进程被杀 -->
        <service
            android:name="com.yunx.app.data.download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

<provider
            android:name="com.yunx.app.LaunchGate"
            android:authorities="${applicationId}.launchgate"
            android:exported="false" />


    </application>

</manifest>
